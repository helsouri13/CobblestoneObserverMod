{
	"schemaVersion": 1,
	"id": "cobblestone_observer",
	"version": "${version}",
	"name": "Cobblestone Observer",
	"description": "This is a modified observer to observer only for cobblestone",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/cobblestone_observer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "helsouri.cobblestone_observer.Cobblestone_observer",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "helsouri.cobblestone_observer.client.Cobblestone_ObserverClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"cobblestone-observer.mixins.json",
		{
			"config": "cobblestone-observer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}